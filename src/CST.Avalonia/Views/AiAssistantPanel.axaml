<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CST.Avalonia.ViewModels"
             xmlns:views="using:CST.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="700"
             x:Class="CST.Avalonia.Views.AiAssistantPanel"
             x:DataType="vm:AiAssistantViewModel">

    <!-- #586: generated text renders HERE, in Avalonia controls, and never inside the book's CEF WebView.
         That makes "generated text is visually distinguishable from canonical text" a structural fact
         rather than a styling convention, and keeps live token streaming off the component that SIGSEGVs
         on re-parent.

         LAYOUT: the transcript scrolls; the question box and its controls are pinned at the bottom and
         never move. The first build had this inverted — a fixed header of title, disclaimer, question box
         and four buttons, with the answer scrolling underneath — so the controls consumed the top of a
         narrow panel permanently and the answer got what was left. -->

    <DockPanel LastChildFill="True">

        <!-- ============ The composer, pinned ============ -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,8,8,8">
            <StackPanel Spacing="6">

                <!-- Panel-level refusals: not configured, no book open. These belong to no turn, because no
                     request was made. -->
                <TextBlock Text="{Binding Status}"
                           IsVisible="{Binding HasStatus}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>

                <TextBox Text="{Binding Question}"
                         Watermark="Ask something about the passage (optional)"
                         AcceptsReturn="False"
                         MaxHeight="90"
                         TextWrapping="Wrap"
                         IsEnabled="{Binding CanAsk}"/>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="Explain" Command="{Binding ExplainCommand}"
                            IsEnabled="{Binding CanAsk}" Margin="0,0,4,4"/>
                    <Button Content="Translate" Command="{Binding TranslateCommand}"
                            IsEnabled="{Binding CanAsk}" Margin="0,0,4,4"/>
                    <Button Content="Grammar" Command="{Binding GrammarCommand}"
                            IsEnabled="{Binding CanAsk}" Margin="0,0,4,4"/>
                    <Button Content="Word by word" Command="{Binding WordByWordCommand}"
                            IsEnabled="{Binding CanAsk}" Margin="0,0,4,4"/>
                    <!-- Visible only while a turn runs: §10 requires a stop control, and a permanently dead
                         button is not one. -->
                    <Button Content="Stop" Command="{Binding StopCommand}"
                            IsVisible="{Binding IsBusy}" Margin="0,0,4,4"/>
                </WrapPanel>

                <TextBlock Text="Answers are generated by a model you configure. They can be wrong — check them against the text."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ============ The transcript, scrolling ============ -->
        <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <TextBlock Text="Ask about the passage you are reading. Select some text first and the answer will be about the selection."
                           IsVisible="{Binding !HasTurns}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <ItemsControl ItemsSource="{Binding Turns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AiTurnViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,10">

                                <!-- What was asked -->
                                <TextBlock Text="{Binding PresetLabel}" FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding Question}"
                                           IsVisible="{Binding HasQuestion}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <!-- What it is about, on screen from the first second. A browser selection
                                     persists invisibly, so a stale one has to be visible BEFORE the answer
                                     rather than discovered in it. -->
                                <Border IsVisible="{Binding HasSubject}"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="3" Padding="6,4">
                                    <TextBlock Text="{Binding Subject}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>

                                <!-- Built by us from the bundle, never parsed out of the answer. One line;
                                     the canon path and every printed page live on the tooltip. -->
                                <TextBlock Text="{Binding Citation}"
                                           ToolTip.Tip="{Binding CitationDetail}"
                                           IsVisible="{Binding Citation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <!-- The model did not see all of the passage, which changes how far the
                                     answer can be trusted — the one caveat that is not merely informational. -->
                                <Border IsVisible="{Binding IsPartialPassage}"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="8,5" Margin="0,2,0,0">
                                    <TextBlock Text="Only part of this passage was sent — it was too long to include in full."
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Progress or failure. Two different things, drawn two different ways: a
                                     counter and an error reading identically is how a reader ends up staring
                                     at a dead panel. -->
                                <TextBlock Text="{Binding Status}"
                                           IsVisible="{Binding HasStatus}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Classes.failed="{Binding Failed}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.failed">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>

                                <Button Content="Try again"
                                        Command="{Binding $parent[ItemsControl].((vm:AiAssistantViewModel)DataContext).RetryCommand}"
                                        IsVisible="{Binding Failed}"
                                        HorizontalAlignment="Left"
                                        Margin="0,2,0,0"/>

                                <!-- The model thinking aloud: offered, collapsed, and never part of the
                                     answer. Its ARRIVAL is what distinguishes a slow request from a dead
                                     one, which is why it is no longer discarded. -->
                                <Expander Header="{Binding ReasoningHeader}"
                                          IsVisible="{Binding HasReasoning}"
                                          Margin="0,2,0,0">
                                    <SelectableTextBlock Text="{Binding Reasoning}"
                                                         TextWrapping="Wrap"
                                                         FontSize="11"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Expander>

                                <!-- The answer. One selectable control with styled runs, so a reader can drag
                                     across the whole thing and copy it as clean prose. -->
                                <SelectableTextBlock views:AnswerInlines.Spans="{Binding Spans}"
                                                     IsVisible="{Binding HasAnswer}"
                                                     TextWrapping="Wrap"
                                                     Margin="0,4,0,0"/>

                                <!-- Facts about how the request was assembled, not failures. Collapsed,
                                     because at full weight beside the answer they read as a list of errors. -->
                                <Expander Header="{Binding NoticesHeader}"
                                          IsVisible="{Binding HasNotices}"
                                          Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding Notices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!-- What the turn cost, in time and tokens. The user is paying for both. -->
                                <TextBlock Text="{Binding Footer}"
                                           IsVisible="{Binding HasFooter}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
