<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CST.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="600"
             x:Class="CST.Avalonia.Views.AiAssistantPanel"
             x:DataType="vm:AiAssistantViewModel">

    <!-- #586: generated text renders HERE, in Avalonia controls, and never inside the book's CEF WebView.
         That makes "generated text is visually distinguishable from canonical text" a structural fact
         rather than a styling convention, and keeps live token streaming off the component that SIGSEGVs
         on re-parent. -->

    <DockPanel Margin="8">

        <!-- Ask -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Ask about the passage you are reading"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Answers are generated by a model you configure. They can be wrong — check them against the text."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,8"/>

            <TextBox Text="{Binding Question}"
                     Watermark="Optional: ask something specific"
                     AcceptsReturn="False"
                     IsEnabled="{Binding CanAsk}"/>

            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Explain" Command="{Binding ExplainCommand}" IsEnabled="{Binding CanAsk}" Margin="0,0,6,6"/>
                <Button Content="Translate" Command="{Binding TranslateCommand}" IsEnabled="{Binding CanAsk}" Margin="0,0,6,6"/>
                <Button Content="Grammar" Command="{Binding GrammarCommand}" IsEnabled="{Binding CanAsk}" Margin="0,0,6,6"/>
                <Button Content="Word by word" Command="{Binding WordByWordCommand}" IsEnabled="{Binding CanAsk}" Margin="0,0,6,6"/>
                <!-- Visible only while a turn runs: §10 requires a stop control, and a permanently dead
                     button is not one. -->
                <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,6,6"/>
            </WrapPanel>

            <TextBlock Text="{Binding Status}"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Usage, pinned to the bottom: the user is paying for these tokens. -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Usage}"
                   IsVisible="{Binding Usage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,8,0,0"/>

        <!-- The answer and its chrome.
             Order and weight are deliberate: the ANSWER is what the reader came for, so it is the only
             thing at full weight. The citation captions it in one quiet line, and the notices sit under a
             collapsed header — at equal weight they read as a wall of errors, which is what the first
             build of this panel actually looked like. -->
        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Built by us from the bundle, never parsed out of the answer. One line; the canon path
                     and every printed page live on the tooltip. -->
                <TextBlock Text="{Binding Citation}"
                           ToolTip.Tip="{Binding CitationDetail}"
                           IsVisible="{Binding Citation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- The model did not see all of the passage, which changes how far the answer can be
                     trusted — the one caveat that is not merely informational. -->
                <Border IsVisible="{Binding IsPartialPassage}"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="8,5" Margin="0,6,0,0">
                    <TextBlock Text="Only part of this passage was sent — it was too long to include in full."
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Selectable: readers copy translations out of this panel. -->
                <SelectableTextBlock Text="{Binding Answer}"
                                     IsVisible="{Binding HasAnswer}"
                                     TextWrapping="Wrap"
                                     Margin="0,10,0,0"/>

                <!-- Collapsed by default and phrased as what it is: facts about how the request was
                     assembled, not failures. Open it and they are still quiet. -->
                <Expander Header="{Binding NoticesHeader}"
                          IsVisible="{Binding HasNotices}"
                          Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
